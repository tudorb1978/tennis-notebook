{
  "name": "tennis-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "test:app": "node tests/app/smoke.cjs",
    "export:android": "expo export --platform android",
    "test": "node --test tests/domain/*.test.ts tests/storage/*.test.ts tests/application/*.test.ts tests/architecture/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@pdf-lib/fontkit": "1.1.1",
    "expo": "~58.0.23",
    "expo-asset": "58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-keep-awake": "~58.0.3",
    "expo-sharing": "~58.0.22",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "~19.3.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  }
}
