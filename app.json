{
  "expo": {
    "name": "tennis-notebook",
    "slug": "tennis-notebook",
    "icon": "./assets/tennis-notebook.png",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "tennis-notebook",
    "android": {
      "package": "uk.tennisnotebook.app",
      "versionCode": 1,
      "allowBackup": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": { "bundleIdentifier": "uk.tennisnotebook.app", "supportsTablet": true },
    "web": { "bundler": "metro", "favicon": "./assets/tennis-notebook.png" },
    "plugins": [
      "expo-sqlite",
      ["expo-build-properties", { "android": { "compileSdkVersion": 37, "targetSdkVersion": 36 } }]
    ]
  }
}
